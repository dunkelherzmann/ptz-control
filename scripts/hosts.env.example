# Copy to scripts/hosts.env (not tracked by git) and put in the names of your own machines.
# The ssh names of the Linux and Windows machines scripts/check.sh builds and tests on:
PTZ_LINUX_HOST=my-linux
PTZ_WINDOWS_HOST=my-windows
# The Windows machine's name in Master Control (mctl status), whose desktop session runs the app test:
PTZ_WINDOWS_MCTL=windows
