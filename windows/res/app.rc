#include <winver.h>

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Herbert Cisneros"
            VALUE "FileDescription", "PTZ Control"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "PTZControl"
            VALUE "LegalCopyright", "PTZ Coordinates Controller by Herbert Cisneros"
            VALUE "OriginalFilename", "PTZControl.exe"
            VALUE "ProductName", "PTZ Control"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
