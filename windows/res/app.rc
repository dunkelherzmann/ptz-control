#include <winver.h>
#include "ptz_version.h"

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PTZ_VERSION_MAJOR,PTZ_VERSION_MINOR,PTZ_VERSION_PATCH,0
PRODUCTVERSION PTZ_VERSION_MAJOR,PTZ_VERSION_MINOR,PTZ_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Herbert Cisneros"
            VALUE "FileDescription", "PTZ Control"
            VALUE "FileVersion", PTZ_VERSION
            VALUE "InternalName", "PTZControl"
            VALUE "LegalCopyright", "PTZ Coordinates Controller by Herbert Cisneros"
            VALUE "OriginalFilename", "PTZControl.exe"
            VALUE "ProductName", "PTZ Control"
            VALUE "ProductVersion", PTZ_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
